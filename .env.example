# UK & London Planner — environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# ============================================================
# AI STAFF — required to run any agent
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# GOHIGHLEVEL CRM — newsletter, webhooks, pipelines
# ============================================================
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_CALENDAR_ID=
GHL_WEBHOOK_ITINERARY_PURCHASE=
GHL_WEBHOOK_CONTACT_FORM=
GHL_WEBHOOK_EMAIL_CAPTURE=
GHL_WEBHOOK_NEWSLETTER=

# ============================================================
# MANIFEST FINANCIAL — payment links
# ============================================================
MANIFEST_LINK_TIER1=
MANIFEST_LINK_TIER2=
MANIFEST_LINK_TIER3=
MANIFEST_LINK_UK_SHORT=
MANIFEST_LINK_UK_STANDARD=
MANIFEST_LINK_UK_EXTENDED=

# ============================================================
# OPTIONAL — only needed when wired
# ============================================================
OPENWEATHERMAP_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_KEY=
